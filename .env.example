# ============================================================================
# REQUIRED — no working default in code; the app will not run correctly,
# or a whole feature (auth, AI, Supabase) will silently no-op, without these.
# ============================================================================

FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Set at least one AI provider — Gemini is checked first, Anthropic is the
# fallback (backend/claude.py). Setting only one is fine.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Clerk Dashboard -> API Keys. CLERK_PUBLISHABLE_KEY also accepts
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY as a fallback name (see Optional below).
CLERK_PUBLISHABLE_KEY=
# Clerk Dashboard -> API Keys -> "Frontend API URL" (e.g.
# https://your-app.clerk.accounts.dev). This is the JWT `iss` claim; it's
# used both to derive the JWKS endpoint and to validate incoming tokens.
CLERK_JWT_ISSUER=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ============================================================================
# OPTIONAL — every value below already has a working default in code.
# Set one only to override that default; leaving it blank/unset is safe.
# ============================================================================

# Supabase table-name overrides (app.py). Defaults already match the real
# schema (scripts/sql/*.sql) -- only set these if a deployment renames a table.
SUPABASE_PREFS_TABLE=user_preferences
SUPABASE_COMMUNITY_KNOWLEDGE_TABLE=community_knowledge
SUPABASE_USER_MEMORIES_TABLE=user_memories
SUPABASE_STUDY_BOOKMARKS_TABLE=study_bookmarks
SUPABASE_ANSWER_FEEDBACK_TABLE=answer_feedback

# Flask runtime
FLASK_ENV=development
PORT=5001

# Service-worker cache-busting version string, stamped into
# static/service-worker.js's CACHE_VERSION at request time by app.py's
# /service-worker.js route. Bump on deploy to force clients to drop stale
# caches; also doubles as the corpus/deploy-hash component of the cache-key
# story for corpus-derived routes (plan.md §14.3.1, §14.8). Safe to leave
# unset -- defaults to "v8".
DEPLOY_HASH=v8

# Alias also read directly by the Gemini SDK; only needed if it must differ
# from GEMINI_API_KEY.
GOOGLE_API_KEY=

# Override the Gemini model name used for the primary /ask synthesis call
# (backend/claude.py, several call sites; defaults to _DEFAULT_GEMINI_MODEL,
# "gemini-3.5-flash-lite", when unset). Changing this without adding a
# matching entry to backend/cost_meter.py's _PRICE_PER_M table makes every
# call to the new model silently log cost_usd=0.0 instead of failing loudly
# -- exactly the ledger-integrity failure mode plan.md §20 (cost-ledger-
# integrity history) documents and fixed once already. Add the model's price
# to _PRICE_PER_M in the same change that sets this.
GEMINI_MODEL=

# Rate limiting (backend/rate_limit.py, plan.md §16.3-L2)
# Shared store for the unified rate-limit middleware. Unset in local dev:
# falls back to an in-process store with a loud startup warning (fine for
# one instance; per plan.md §16.1 D3 it is NOT a real limit across Vercel
# Fluid's multiple concurrent instances -- required in production).
# Point at an Upstash Redis database over rediss://, e.g.:
#   RATE_LIMIT_REDIS_URL=rediss://default:<password>@<host>:<port>
RATE_LIMIT_REDIS_URL=
# Kill switch for the whole rate-limit middleware; tests/conftest.py and
# ci.yml may set this to "false". Defaults to enabled.
RATELIMIT_ENABLED=true

# Agentic AI tool-use loop (backend/claude.py:129, plan.md §9 / Prompt 20).
# Unconditionally OFF by default in every environment, with no prod-aware
# carve-out (unlike CLERK_ENFORCE_AUTH below) -- flipping it adds multi-step
# tool-calling turns to every /ask call, multiplying per-question AI spend.
# plan.md §16.6/§16.7 required the rate-limiter unification (Phase 9a) and
# the cost breaker (Phase 9b) to land before this could safely ship; both
# have since shipped (2026-08-22/23, see plan.md §16.9/§16.10). Even so, no
# dated decision has turned this on by default (plan.md §27.5 flags it as
# still deliberately gapped for a first pass) -- leave unset/false in
# production until a follow-up explicitly enables it after a soak period.
AI_AGENTIC_TOOLS=false

# Cloudflare Turnstile bot gate for anonymous /ask past a per-IP hourly
# threshold (backend/turnstile.py, plan.md §16.4 / §16.6 Phase 9c). Chosen
# over Vercel BotID: BotID's server-side verification SDK is JavaScript-only
# and /ask is a Python FastAPI route at every Vercel plan tier, so BotID
# cannot be wired in here regardless of budget (docs/SECURITY.md §8).
# Defaults to off; every function in backend/turnstile.py is a true no-op
# when unset, so local dev/tests are unaffected.
TURNSTILE_ENABLED=false
# Server secret from the Cloudflare Turnstile dashboard -- never sent to the
# browser. Required once TURNSTILE_ENABLED=true; if the flag is on but this
# is empty, verify_turnstile_token() fails CLOSED (rejects every challenged
# request) rather than silently granting a bypass.
TURNSTILE_SECRET_KEY=
# Public site key -- not a secret, safe to expose to the frontend once the
# widget itself is built. backend/turnstile.py only reads it; it renders
# nothing server-side.
TURNSTILE_SITE_KEY=
# Anonymous requests per IP per trailing hour before a challenge is owed.
# Defaults to 5 if unset/invalid.
TURNSTILE_ANON_HOURLY_THRESHOLD=5

# Per-caller daily AI spend ceiling (USD), enforced on the /ask request path
# before every model call — see backend/cost_meter.py::check_user_budget_and_enforce.
# Defaults to 2.00 even if unset; set to "0" to disable. Requires the
# ai_usage_log table to have user_id/client_key columns — run
# scripts/migrate_ai_usage_log_add_user_columns.sql once if it predates them.
#
# NOTE (decided 2026-08-23, plan.md §20.2 PHASE 20c): this is a good-faith
# guardrail against accidental/single-user runaway spend, NOT an anti-abuse
# control — Clerk signup is frictionless, so a caller who hits this ceiling
# can create a second account and continue. The actual ceiling against a
# motivated multi-account attacker is DAILY_BUDGET_USD below (the global
# breaker, caps total spend regardless of account count) plus the Vercel
# WAF (docs/SECURITY.md §7, IP+JA4-keyed, survives account rotation).
PER_USER_DAILY_BUDGET_USD=2.00

# Clerk
# Fallback name for CLERK_PUBLISHABLE_KEY (Required section above) — set
# whichever one you already have, not both.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Recommended before production launch: backend/auth.py skips JWT audience
# verification entirely (`verify_aud: False`) whenever this is unset, so any
# correctly-signed token from the same Clerk issuer -- including one minted
# for a different app sharing that Clerk instance -- would be accepted here.
# This is the sole authorization gate in front of the destructive
# /api/user/delete-account endpoint (backend/routes_privacy.py), so confirm
# this is set in production before relying on that gate.
CLERK_AUDIENCE=
# Must stay env-configurable, not a literal: this needs to differ per
# environment (false for local dev/tests — see tests/conftest.py — true in
# production), unlike the tuning constants that were folded into code.
CLERK_ENFORCE_AUTH=false
# CLERK_SECRET_KEY: required for POST /api/user/delete-account (plan.md
# §8.D.1) to delete the Clerk identity itself, not just the app's Supabase
# rows, via Clerk's Backend API (backend/routes_privacy.py). Without it,
# delete-account still wipes Supabase data but reports clerk_deleted=false.
CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SIGNING_SECRET (plan.md §39.2): the "whsec_..." signing
# secret Clerk shows when you create an Endpoint for POST /api/webhooks/clerk
# in Clerk Dashboard -> Webhooks, subscribed to the user.deleted event.
# Verifies Clerk's Svix-signed request is genuine (backend/routes_webhooks.py)
# -- without it, that route fails closed (503) rather than trusting an
# unverified request. This is the completeness backstop for account
# deletion when a Clerk identity is removed via Clerk's own <UserProfile />
# UI or by an operator in the Clerk Dashboard, neither of which calls this
# app's own /api/user/delete-account endpoint.
CLERK_WEBHOOK_SIGNING_SECRET=

# Sefaria API base URL overrides (backend/sefaria_library.py:31-32) -- every
# text/index/search lookup the reader makes is proxied through these. Mainly
# used to point at a mock endpoint in CI/tests; leave unset in normal
# dev/production to use Sefaria's live API.
SEFARIA_API=https://www.sefaria.org.il/api
SEFARIA_V3_API=https://www.sefaria.org.il/api/v3

# Runtime behavior
# Validates the customs corpus at startup; skipped in production by default
# to avoid billing Active CPU on every cold start. Leave unset unless testing.
VALIDATE_CUSTOMS_AT_STARTUP=

# Observability (plan.md §7 / §8.E.1)
LOG_LEVEL=INFO
# Sentry error tracking — a true no-op until this is set (see backend/logging_setup.py)
SENTRY_DSN=
# Sentry Browser DSN — separate Sentry project ("Browser JavaScript"), public
# by design (that's what a browser DSN is), but still env-only and a true
# no-op until set: no script tag is rendered, no CDN request, no console
# warning (see app.py's index() route + templates/index.html + plan.md §17.1)
SENTRY_DSN_BROWSER=
# Optional: also POST _capture_backend_error payloads to this URL
ERROR_LOG_WEBHOOK_URL=
# Daily AI-spend guardrail — unset disables BOTH checks below entirely (see
# backend/cost_meter.py:_daily_budget_usd, shared by two consumers):
#   1. check_daily_budget_and_alert — the /api/devtools/budget-check Vercel
#      Cron route in vercel.json; alert-only, does not block requests.
#   2. is_global_cost_breaker_tripped — the real global ceiling that PAUSES
#      /ask for all callers once reached (plan.md §16.3-L3, §16.10). This is
#      the actual anti-abuse ceiling per plan.md §20.2 PHASE 20c's Option A
#      decision (2026-08-23) — PER_USER_DAILY_BUDGET_USD above is only a
#      guardrail.
# Set to 10.00 in production (2026-09-01, Akiva) -- Gemini is $0.00/free-tier
# and claude-haiku-4-5 fallback is $1.00/$5.00 per 1M tokens, so a single
# worst-case /ask call costs ~$0.0265; $10/day is generous for normal use
# but still caps a runaway/multi-account-abuse scenario.
DAILY_BUDGET_USD=10.00
# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" — set
# this in the Vercel project env vars, not just here, to protect cron routes.
# Only needed if you deploy on Vercel; leave blank otherwise.
CRON_SECRET=

# SonarCloud error tracking and code quality (see sonar-project.properties)
SONAR_TOKEN=