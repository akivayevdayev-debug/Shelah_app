# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build artifacts
dist/
build/
*.egg-info/
node_modules/

# Virtual environments
.venv/
venv/
env/

# Environment files
.env
.env.*
!.env.example

# Potentially sensitive JSON exports/credentials
*.secret.json
*.secrets.json
*credentials*.json
*service-account*.json
*private*.json

# Editor folders
.vscode/
.idea/

# OS files
.DS_Store

# Logs
*.log

# Generated QA/debug artifacts
test-results/
reports/browser_qa/
reports/library_leaf_remove_fix_report.sample.json
reports/library_leaf_remove_fix_report.slice180.json
templates/index_backup.html
error_audit.txt
sefardic_prayers.json
# plan.md §8.C.1 security-audit pass: a live Google API key was found
# committed inside test_results.txt (raw model-call output, including the
# request URL's ?key= query param) across several commits — see
# docs/SECURITY.md. Ignored repo-wide so a re-run of whatever produced it
# can't get re-committed. The scratch/backup holding dir it lived in was
# renamed from _workspace_backups_and_trash/ to _workspace_backups/ and
# cleared out (2026-09-01) -- everything that had been sitting in it was
# confirmed stale/unreferenced and removed; this only stops *new* additions.
test_results.txt
_workspace_backups/

# Sefaria local cache (runtime-generated)
.sefaria_cache/

# graphify local build cache (AST parse cache + stat-index; regenerated by
# `graphify update .`, contains absolute local file paths, not for commit)
graphify-out/

# Ignore all hidden files and folders by default
.*
**/.*

# explicit exceptions to force Claude to view these specific hidden folders
!.agents/
!.claude/
!.github/
!.pre-commit-config.yaml

# plan.md §8.F.2 / Prompt 18 item 2: pa11y-ci config (key-page WCAG2AA URLs
# + defaults), read by .github/workflows/ci.yml's accessibility-scan step
# and `npm run test:a11y` -- without this exception the blanket `.*` rule
# above silently drops it from every commit and the CI step 404s trying to
# read a config file that was never actually version-controlled.
!.pa11yci.json

# Python 3.14 migration (2026-08-21): pins the interpreter version for
# Vercel (https://vercel.com/docs/functions/runtimes/python/python-version)
# and any local `pyenv`/`uv`-aware tooling -- without this exception the
# blanket `.*` rule above silently drops it from every commit and Vercel
# falls back to its platform default instead of the version this repo's
# lock files / CI are actually pinned and verified against.
!.python-version
.vercel
.env*
