{
  "name": "sh'elah_app",
  "version": "1.0.0",
  "description": "Sh'elah build tooling (Tailwind CSS)",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "node --experimental-vm-modules --test tests_js/*.test.js",
    "build:css": "tailwindcss -i ./static/css/tailwind.input.css -o ./static/css/tailwind.css --minify",
    "test:a11y": "npm run test:a11y:light && npm run test:a11y:dark",
    "test:a11y:light": "pa11y-ci --config .pa11yci.json",
    "test:a11y:dark": "node scripts/a11y_dark_scan.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akivayevdayev-debug/Shelah_app.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/akivayevdayev-debug/Shelah_app/issues"
  },
  "homepage": "https://github.com/akivayevdayev-debug/Shelah_app#readme",
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "pa11y-ci": "^4.1.1",
    "supabase": "^2.116.0",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "@sentry/browser": "^10.69.0"
  }
}
