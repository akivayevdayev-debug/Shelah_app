{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "functions": {
        "api/index.py": {
            "memory": 1024,
            "maxDuration": 90
        }
    },
    "rewrites": [
        {
            "source": "/((?!static/|favicon\\.ico|manifest\\.webmanifest|service-worker\\.js).*)",
            "destination": "/api/index"
        }
    ],
    "headers": [
        {
            "source": "/static/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600"
                }
            ]
        }
    ]
}
